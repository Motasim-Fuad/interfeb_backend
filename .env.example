# Safe local defaults. Docker Compose can run directly with this file.
# For custom/production secrets, copy it to .env and override the values.

APP_NAME=Interfab QC Backend
ENV=local
DEBUG=true

# Database - when running via docker-compose, host "db" is the postgres container name (don't change it)
DATABASE_URL=postgresql+psycopg2://interfab:interfab@db:5432/interfab

# Redis - "redis" is the docker-compose service name
REDIS_URL=redis://redis:6379/0

# JWT - CHANGE THIS before any real deployment
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ADMIN_TOKEN_EXPIRE_MINUTES=720
APP_TOKEN_EXPIRE_MINUTES=10080

# Admin bootstrapping - required every time you create an admin account (first one or later ones).
# Change this to your own random string, keep it private.
ADMIN_SETUP_SECRET=change-this-setup-secret

# CORS - "*" allows any origin (fine for local dev). In production set your real domain(s),
# comma-separated, e.g: https://dashboard.interfab.com,https://app.interfab.com
ALLOWED_ORIGINS=*

ROLL_LOCK_TTL_SECONDS=600

# Storage: "local" for now. Switch to "s3" later - just fill the AWS_* values below too.
STORAGE_BACKEND=local
MEDIA_ROOT=/app/media
MEDIA_BASE_URL=http://localhost:8000/media

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=

# FabriQ assistant (dashboard chat). The built-in engine answers every question it understands
# (exact, instant). Only questions it cannot understand go to the AI model below (local Ollama
# by default, free and offline), which just picks a report tool; every number still comes from
# the backend. If Ollama is down or slow, the built-in engine answers instead.
#   Laptop / 8 GB Docker:  ASSISTANT_LLM_MODEL=qwen2.5:3b
#   VPS with 16 GB RAM:    ASSISTANT_LLM_MODEL=qwen2.5:7b
# Leave ASSISTANT_LLM_BASE_URL empty to use only the offline engine.
# OpenAI / Groq / Gemini also work through their OpenAI-compatible endpoints (fill the API key).
# Off by default: the built-in engine is exact and answers instantly. To let an AI handle
# questions the engine does not understand, set e.g. ASSISTANT_LLM_BASE_URL=http://ollama:11434/v1
# and ASSISTANT_LLM_MODEL=qwen2.5:3b (slow on CPU-only servers).
ASSISTANT_LLM_BASE_URL=
ASSISTANT_LLM_API_KEY=
ASSISTANT_LLM_MODEL=
ASSISTANT_LLM_TIMEOUT_SECONDS=60
ASSISTANT_EMBEDDER=hash

# Mill report reader (Dashboard -> PLM -> Roll Planning -> "From Mill Report").
# Reads photos, scans and handwritten sheets. Excel and CSV never need a model.
#
# Main reader: Google Gemini (fast, a few seconds per photo, free tier with daily limits).
#   Get a key at https://aistudio.google.com -> "Get API key", paste it into VISION_LLM_API_KEY.
#   Photos are sent to Google. Several models can be listed, comma-separated: they are tried in
#   order, so a busy or retired one is skipped. Google retires old names for new keys from time
#   to time; if every one fails, check the current free Flash model names in AI Studio.
# Without a key (or if Gemini fails / hits its limit) the local Ollama model below is used
# automatically: free and offline, but 1-8 minutes per photo on a CPU-only machine.
VISION_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VISION_LLM_API_KEY=
VISION_LLM_MODEL=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-flash-latest
VISION_LLM_TIMEOUT_SECONDS=120

#   Laptop / 8 GB Docker:  VISION_FALLBACK_MODEL=qwen2.5vl:3b
#   VPS with 16 GB RAM:    VISION_FALLBACK_MODEL=qwen2.5vl:7b   (better on handwriting)
VISION_FALLBACK_BASE_URL=http://ollama:11434/v1
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_MODEL=qwen2.5vl:3b
VISION_FALLBACK_TIMEOUT_SECONDS=1800
